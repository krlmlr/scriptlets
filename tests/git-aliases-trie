#!/bin/sh
# Render rcm/gitaliases as the trie that handbook/config/git-aliases/README.md
# carries, and print it on stdout. `07-git-aliases` compares the page against
# this, so the page is derived rather than typed, and an alias that arrives
# without it fails the run until it is regenerated:
#
#   tests/git-aliases-trie
#
# The shape is derived. The names that head a group of their own are the list
# below, because nothing in the file says which they are: each one borrows the
# prefix of a command it has nothing to do with -- `conflicts` under `co`, the
# stash under `s` -- and would read as a variant of it anywhere else in the tree.
set -eu

# Longest first is not needed here, the code sorts them; what matters is that a
# head which is not an alias itself, `st` and `pr` among them, becomes a node
# with no command of its own.
promoted='conflicts dm echo fft lsf mu pr sq st wt'

repo=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

git config -f "$repo/rcm/gitaliases" --list |
    sed -n 's/^alias\.//p' |
    awk -v promoted="$promoted" '
{
    name = $0
    sub(/=.*$/, "", name)
    text = $0
    sub(/^[^=]*=/, "", text)
    expansion[name] = text
    names[++count] = name
}

function is_alias(name) {
    return (name in expansion)
}

function mark_of(name) {
    if (!is_alias(name))
        return "."
    return substr(expansion[name], 1, 1) == "!" ? "!" : "*"
}

# A shell alias shows the first 60 characters of what it runs, which is enough
# to tell one from another; the file owns the rest, and an ellipsis says where
# it takes over. The leading `!` is the mark rather than part of the text.
function summary_of(name,   text) {
    if (!is_alias(name))
        return ""
    text = expansion[name]
    if (substr(text, 1, 1) != "!")
        return text
    text = substr(text, 2)
    if (length(text) > 60)
        text = substr(text, 1, 60) "\342\200\246"
    return text
}

# The label an edge carries: one letter, or the whole run of them where every
# step in between is a node no alias stops at.
function edge_label(base, first,   label, node, extension) {
    label = first
    while (1) {
        node = base label
        if (is_alias(node))
            return label
        extension = only_child(node)
        if (extension == "")
            return label
        label = label extension
    }
}

# The one letter every name below NODE continues with, or nothing where they
# differ -- which is what makes a chain worth collapsing.
function only_child(node,   i, name, letter, found) {
    found = ""
    for (i = 1; i <= count; i++) {
        name = names[i]
        if (name == node || index(name, node) != 1 || group_of(name) != base_group)
            continue
        letter = substr(name, length(node) + 1, 1)
        if (found == "")
            found = letter
        else if (found != letter)
            return ""
    }
    return found
}

# The group a name belongs to: the longest promoted head it starts with, or its
# first letter.
function group_of(name,   i, head, best) {
    best = ""
    for (i = 1; i <= heads; i++) {
        head = promoted_head[i]
        if (index(name, head) == 1 && length(head) > length(best))
            best = head
    }
    return best == "" ? substr(name, 1, 1) : best
}

# One alphabetical run over the groups, in which a name that heads a group of
# its own comes before the family whose letter it borrowed: `dm` before `d`,
# and `conflicts` before `c`. The specific before the general, so that a group
# is read before the family it would otherwise be taken for a variant of.
function precedes(a, b,   first_a, first_b) {
    first_a = substr(a, 1, 1)
    first_b = substr(b, 1, 1)
    if (first_a != first_b)
        return first_a < first_b
    if (length(a) == 1)
        return 0
    if (length(b) == 1)
        return 1
    return a < b
}

function line_of(node, indent, connector, label,   mark, summary) {
    mark = mark_of(node)
    summary = summary_of(node)
    return indent connector label " " mark (summary == "" ? "" : " " summary)
}

function render(base, indent,   i, j, name, label, seen, labels, n, last, node) {
    n = 0
    delete seen
    for (i = 1; i <= count; i++) {
        name = names[i]
        if (name == base || index(name, base) != 1 || group_of(name) != base_group)
            continue
        label = edge_label(base, substr(name, length(base) + 1, 1))
        if (label in seen)
            continue
        seen[label] = 1
        labels[++n] = label
    }
    for (i = 1; i < n; i++)
        for (j = i + 1; j <= n; j++)
            if (labels[j] < labels[i]) {
                label = labels[i]; labels[i] = labels[j]; labels[j] = label
            }
    for (i = 1; i <= n; i++) {
        last = (i == n)
        node = base labels[i]
        print line_of(node, indent, last ? "\342\224\224\342\224\200" : "\342\224\234\342\224\200", labels[i])
        render(node, indent (last ? "   " : "\342\224\202  ") spaces(length(labels[i]) - 1))
    }
}

function spaces(n,   s) {
    s = ""
    while (n-- > 0)
        s = s " "
    return s
}

END {
    heads = split(promoted, promoted_head, " ")

    groups = 0
    for (i = 1; i <= count; i++) {
        head = group_of(names[i])
        if (!(head in seen_group)) {
            seen_group[head] = 1
            group[++groups] = head
        }
    }

    for (i = 1; i < groups; i++)
        for (j = i + 1; j <= groups; j++)
            if (precedes(group[j], group[i])) {
                head = group[i]; group[i] = group[j]; group[j] = head
            }

    for (i = 1; i <= groups; i++) {
        base_group = group[i]
        print line_of(base_group, "", "", base_group)
        render(base_group, "")
        if (i < groups)
            print ""
    }
}
'
