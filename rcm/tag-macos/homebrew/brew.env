# Installed as ~/.homebrew/brew.env, and read by `brew` itself -- every
# invocation, from any shell, and from anything that is not a shell at all.
# An `export` in ~/.bash_aliases_os reached interactive bash and zsh alone,
# which is why these live here instead.
#
# The format is not shell: `brew` reads the file line by line, keeps the ones
# that begin with HOMEBREW_, and exports each verbatim. No `export` keyword,
# no quoting, no expansion -- the value is the rest of the line. Lines that
# begin with anything else, `#` included, are skipped, which is what makes
# these comments legal.
#
# Only the user file is ours. /etc/homebrew/brew.env and
# $HOMEBREW_PREFIX/etc/homebrew/brew.env are read first and lose to it,
# unless the system one sets HOMEBREW_SYSTEM_ENV_TAKES_PRIORITY. Setting
# XDG_CONFIG_HOME moves the user file to $XDG_CONFIG_HOME/homebrew/brew.env
# and this one stops being read; nothing here sets that variable.

# Run `brew update` at most once a day before `install`, `upgrade` and
# friends. Homebrew already waits a day by default, but drops to an hour for
# the rest of the machine's life once a developer command has been run, and
# to five minutes where the JSON API is off. A day-old formula index is
# fresh enough for interactive use -- the same trade-off `~/.zshrc` makes for
# compinit's audit -- so pin the day rather than inherit whichever default
# this machine's history has earned.
HOMEBREW_AUTO_UPDATE_SECS=86400

# `install`, `upgrade` and `reinstall` print their plan and then stop to ask,
# whenever it reaches past the packages named on the command line -- which it
# does as soon as one of them needs a dependency that is not installed yet,
# and again when an upgrade pulls in a new one. The question has only ever
# had one answer here: install what the package needs. Take the plan as
# printed and carry on.
HOMEBREW_NO_ASK=1
