#! /bin/bash
# Sourced from ~/.bash_aliases, installed only on macOS.

# Open a delimited text file in LibreOffice Calc, delimiter preset so that the
# import dialog does not ask. `soffice-macos` is macOS-only too.
alias csv='soffice-macos --calc --infilter="Text - txt - csv (StarCalc)":44,34,76,1,,,,'
alias csv2='soffice-macos --calc --infilter="Text - txt - csv (StarCalc)":59,34,76,1,,,,'
alias tsv='soffice-macos --calc --infilter="Text - txt - csv (StarCalc)":9,34,76,1,,,,'

# Homebrew keeps `bit` here; the completion is generated by the binary itself.
complete -C /opt/homebrew/bin/bit bit

# Homebrew's own settings are not here: `brew` reads them from
# ~/.homebrew/brew.env, which reaches it from every shell and from none.
