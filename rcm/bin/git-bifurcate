#!/usr/bin/env bash
set -euo pipefail

ns="refs/tags/bif"
mode="apply"
quiet=0

usage() {
  cat <<EOF
Usage: git bifurcate [-q|--quiet] [-r|--remove]

Create a lightweight tag under $ns/<shortest-unique-prefix> for every
commit that has more than one child (a "bifurcation" point), so they
show up in big-picture views such as

  git log --simplify-by-decoration --all
  gitk --all

The prefix is the shortest one that is unique within the bifurcation
set, so reruns rename tags (lengthen/shorten) as bifurcation points
are added or removed.

Commits already pointed at by an unrelated branch, tag, or remote ref
(including annotated tags, dereferenced to the commit) are skipped to
avoid duplicate decoration.

Options:
  -r, --remove   delete all tags under $ns/ and exit
  -q, --quiet    suppress the summary line
  -h, --help     show this help
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--remove) mode="remove" ;;
    -q|--quiet)  quiet=1 ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          printf 'git-bifurcate: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *)           printf 'git-bifurcate: unexpected argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

say() { [ "$quiet" -eq 1 ] || printf '%s\n' "$*"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git for-each-ref --format='%(refname) %(objectname)' "$ns" \
  | LC_ALL=C sort > "$tmp/existing"

if [ "$mode" = "remove" ]; then
  removed=0
  if [ -s "$tmp/existing" ]; then
    while IFS=' ' read -r ref oid; do
      printf 'delete %s %s\n' "$ref" "$oid"
    done < "$tmp/existing" | git update-ref --stdin
    removed=$(wc -l < "$tmp/existing" | tr -d ' ')
  fi
  say "git-bifurcate: removed $removed tag(s) under $ns/."
  exit 0
fi

# Commits already decorated by an unrelated head/tag/remote ref.
# - Skip refs in our own namespace so reruns don't see themselves.
# - For annotated tags %(objectname) is the tag-object SHA; the
#   peeled commit is in %(*objectname). Pick the commit either way.
git for-each-ref --format='%(refname) %(objectname) %(*objectname)' \
  refs/heads refs/tags refs/remotes \
  | awk -v ns="$ns/" '
      index($1, ns) == 1 { next }
      $3 != "" { print $3; next }
      { print $2 }
    ' \
  | LC_ALL=C sort -u > "$tmp/decorated"

git rev-list --all --parents \
  | awk '{ for (i = 2; i <= NF; i++) ++c[$i] } END { for (k in c) if (c[k] > 1) print k }' \
  | LC_ALL=C sort -u > "$tmp/bifurcations"

LC_ALL=C comm -23 "$tmp/bifurcations" "$tmp/decorated" > "$tmp/targets"

# Desired tags. Prefix length is the shortest one that is unique within
# the (sorted) target set: each commit needs enough characters to
# distinguish it from its sort-neighbors. Reruns naturally re-derive
# these, so additions/removals lengthen/shorten names as needed.
: > "$tmp/desired"
if [ -s "$tmp/targets" ]; then
  awk -v ns="$ns/" '
    function common(a, b,    i, n) {
      n = length(a) < length(b) ? length(a) : length(b)
      for (i = 1; i <= n; i++)
        if (substr(a, i, 1) != substr(b, i, 1)) return i - 1
      return n
    }
    { sha[NR] = $1 }
    END {
      n = NR
      for (i = 1; i <= n; i++) {
        L = 1
        if (i > 1) { c = common(sha[i - 1], sha[i]) + 1; if (c > L) L = c }
        if (i < n) { c = common(sha[i], sha[i + 1]) + 1; if (c > L) L = c }
        printf "%s%s %s\n", ns, substr(sha[i], 1, L), sha[i]
      }
    }
  ' "$tmp/targets" | LC_ALL=C sort > "$tmp/desired"
fi

LC_ALL=C comm -23 "$tmp/existing" "$tmp/desired" > "$tmp/to-remove"
LC_ALL=C comm -13 "$tmp/existing" "$tmp/desired" > "$tmp/to-add"

{
  while IFS=' ' read -r ref oid; do
    printf 'delete %s %s\n' "$ref" "$oid"
  done < "$tmp/to-remove"
  while IFS=' ' read -r ref oid; do
    printf 'update %s %s\n' "$ref" "$oid"
  done < "$tmp/to-add"
} | git update-ref --stdin

added=$(wc -l < "$tmp/to-add" | tr -d ' ')
removed=$(wc -l < "$tmp/to-remove" | tr -d ' ')
total=$(git for-each-ref --format='%(refname)' "$ns" | wc -l | tr -d ' ')

if [ "$added" -eq 0 ] && [ "$removed" -eq 0 ]; then
  say "git-bifurcate: $total tag(s) under $ns/ (no changes)."
else
  say "git-bifurcate: $total tag(s) under $ns/ (+$added/-$removed)."
fi
