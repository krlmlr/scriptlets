# ~/.zshrc: read by interactive zsh shells.
#
# The PATH is set up in ~/.profile, which ~/.zprofile hands to zsh at login;
# this file is only for what an interactive shell needs.

# >>> zsh startup profiling (new-macbook-2026) >>>
zsh_startup_mark zshrc
# <<< zsh startup profiling <<<

# The completion system, unless something has already started it.
#
# -i skips insecure directories rather than stopping to ask about them: with no
# terminal to ask on -- a script, a container, `zsh -c` -- plain compinit aborts
# and leaves no compdef behind at all.
if ! (( $+functions[compdef] )); then
    autoload -Uz compinit
    compinit -i
fi

# mise's completions are generated on demand -- `mise completion zsh` shells out
# to the `usage` CLI, which is a process or two at every single shell start.
# This stub stands in until the first Tab on a mise command line: it then loads
# the real completion, which rebinds `mise` to its own `_mise`, and hands that
# first Tab over. Every later one goes straight there.
#
# The generated script needs the `usage` CLI on the PATH (`mise use -g usage`);
# without it, it says so rather than completing.
if (( $+commands[mise] && $+functions[compdef] )); then
    _mise_lazy() {
        unfunction _mise_lazy
        eval "$(mise completion zsh)"
        _mise "$@"
    }

    compdef _mise_lazy mise
fi

# rig appends this line to every startup file it knows about,
# and only ever checks that the line is there:
# ~/.profile sources rigenv once, for every shell, so this copy stays off.
if false; then
. "$HOME/.local/bin/rigenv"
fi

# ---------------------------------------------------------------------------
# Eternal history
#
# One file per day under a directory, so no single file grows without bound
# and everything older stays on disk and greppable.
#
# What bash needed PROMPT_COMMAND for, zsh does natively: SHARE_HISTORY
# appends each command as it is entered and imports what other shells have
# appended, so concurrent sessions stay in sync with no hook.
# ---------------------------------------------------------------------------
HISTSIZE=10000000
SAVEHIST=$HISTSIZE

setopt EXTENDED_HISTORY     # `: <epoch>:<elapsed>;<cmd>` -- bash's HISTTIMEFORMAT
setopt SHARE_HISTORY        # append as you go; pick up other shells' entries
setopt HIST_IGNORE_SPACE    # a leading space keeps a command out
setopt HIST_IGNORE_DUPS     # collapse an immediate repeat
setopt HIST_REDUCE_BLANKS

# Deliberate, and the reason is the whole point of keeping history forever:
# HIST_IGNORE_ALL_DUPS keeps only the most recent instance of a command, which
# destroys the frequency information. "Which commands do I run enough that they
# should be scripts in ~/bin" is a question only the counts can answer.
unsetopt HIST_IGNORE_ALL_DUPS

__zsh_history_dir="$HOME/.zsh_history.d"
[[ -d $__zsh_history_dir ]] || mkdir -p "$__zsh_history_dir"

# One-time migration of a single-file history, matching what the bash side does
# with ~/.bash_eternal_history.
if [[ -f $HOME/.zsh_history && ! -e $__zsh_history_dir/legacy.log ]]; then
  mv "$HOME/.zsh_history" "$__zsh_history_dir/legacy.log"
fi

# ${(%):-%D{...}} is strftime via prompt expansion -- the same string $(date)
# would give, without the fork. This runs at every prompt below, so a fork here
# would be a fork per command.
HISTFILE="$__zsh_history_dir/${(%):-%D{%Y-%m-%d}}.log"

# Pull prior days into the in-memory list so Ctrl-R reaches them. Today's file
# is skipped: zsh loads $HISTFILE itself, and reading it twice duplicates every
# entry. (N) is null-glob, so an empty directory is not an error.
() {
  local f
  for f in "$__zsh_history_dir"/legacy.log(N) "$__zsh_history_dir"/[0-9]*.log(N); do
    [[ $f == $HISTFILE ]] && continue
    fc -R "$f"
  done
}

# Roll over at midnight without needing a new shell. `fc -A` appends only what
# is new -- never `fc -W`, which would write the entire preloaded history into
# today's file and duplicate every prior day.
autoload -Uz add-zsh-hook
__zsh_history_rotate() {
  local today="$__zsh_history_dir/${(%):-%D{%Y-%m-%d}}.log"
  [[ $HISTFILE == $today ]] && return
  fc -A
  HISTFILE=$today
}
add-zsh-hook precmd __zsh_history_rotate

# ---------------------------------------------------------------------------
# The bash bridge
#
# ~/.bash_aliases holds what both shells want -- aliases, exports, the secrets
# file -- and keeps what is bash's alone behind a `$BASH_VERSION` guard. The
# git completions there are one of those: bash's are in that file, zsh's are
# at the bottom of this one, and neither shell reads the other's any more.
#
# What still crosses over is the `complete -C` for `bit` in
# ~/.bash_aliases_os on macOS, and `bashcompinit` is what makes `complete` a
# command zsh knows. It is one autoload, so it costs nothing on Linux, where
# nothing has needed it since.
# ---------------------------------------------------------------------------
autoload -Uz bashcompinit && bashcompinit
[[ -r $HOME/.bash_aliases ]] && source "$HOME/.bash_aliases"

# ---------------------------------------------------------------------------
# Editor and aliases
# ---------------------------------------------------------------------------
if [[ $TERM_PROGRAM == vscode ]]; then
  case $__CFBundleIdentifier in
    com.microsoft.VSCode) export EDITOR="code --wait" ;;
    co.posit.positron)    export EDITOR="positron --wait" ;;
  esac
fi

# ---------------------------------------------------------------------------
# Completion for the git wrappers
#
# `g` hands its arguments straight to git, so git's own completion is exactly
# right for it, whichever one is installed.
#
# `s` is `h` and git in one -- the flags of `h` first, a git command line after
# -- so it gets a function: `_arguments` for the flags, and everything from the
# git command onwards handed back to whatever completes `git`. The git half is
# two actions rather than one because a `*::` rest argument is offered even for
# a word starting with `-`; with a single action, `s -<Tab>` would also list
# git's global options, which `s` forwards to `h`, which rejects them.
# ---------------------------------------------------------------------------

# `s -n comm<Tab>` -- the git command itself.
_s_git_command() {
    words=(git "$words[CURRENT]")
    CURRENT=2
    _normal -p $service
}

# `s -n commit --am<Tab>` -- everything after the git command.
_s_git_args() {
    words=(git "${words[@]}")
    (( CURRENT++ ))
    _normal -p $service
}

_s() {
    _arguments -s -S : \
        '(-i --interactive)'{-i,--interactive}'[run the commands one repository at a time, on the terminal]' \
        '(-n --dry-run)'{-n,--dry-run}'[print the generated script instead of running it]' \
        '(-p --paged)'{-p,--paged}'[page the output through less]' \
        '(-x --log-commands)'{-x,--log-commands}'[trace the commands as they run]' \
        '(-u --unsorted)'{-u,--unsorted}'[leave the repositories unsorted, which is faster]' \
        '(--color --no-color)--color=[when to colorize the output]:when:(auto always never)' \
        '(--color --no-color)--no-color[never colorize the output]' \
        '(-)1: :_s_git_command' \
        '*:: :_s_git_args'
}

if (( $+functions[compdef] )); then
    compdef g=git
    compdef _s s
fi

# ---------------------------------------------------------------------------
# Warp
#
# Warp completes from built-in specs of its own and never asks the shell, so
# every `compdef` above is invisible there -- the request to read the shell's
# completions is closed as not planned (warpdotdev/warp#1979). What Warp does
# read is aliases: a command it has a spec for completes the same way under an
# alias of that command. So `g` becomes one, in Warp and nowhere else. ~/bin/g
# stays the wrapper that scripts and other programs use; an alias only shadows
# it on an interactive command line, and expands to the same git.
#
# `s` has no way out. It is not git, it is a git command line behind flags of
# its own, and Warp has nothing to be taught that with.
# ---------------------------------------------------------------------------
if [[ $TERM_PROGRAM == WarpTerminal ]]; then
    alias g=git
fi
