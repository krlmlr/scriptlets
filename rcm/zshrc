# ~/.zshrc: read by interactive zsh shells.
#
# The PATH is set up in ~/.profile, which ~/.zprofile hands to zsh at login;
# this file is only for what an interactive shell needs.

# The completion system, unless something has already started it.
#
# -i skips insecure directories rather than stopping to ask about them: with no
# terminal to ask on -- a script, a container, `zsh -c` -- plain compinit aborts
# and leaves no compdef behind at all.
#
# The audit is what costs. `-i` does not skip it, it only stops it from asking:
# compaudit still stats every directory in $fpath, which on macOS is Homebrew's
# site-functions and a good part of /usr/share, and it was half of what the
# whole rc chain spent (`zsh-startup-bench --zprof`). It is worth doing, and it
# is not worth doing at every single shell start -- so the audit runs when the
# dump is more than a day old, and every other shell trusts the dump.
#
# `zsh-compinit-refresh` forces the refresh, for the day a newly installed tool
# should complete right now rather than tomorrow.
if ! (( $+functions[compdef] )); then
    autoload -Uz compinit

    () {
        local dump=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION
        [[ -d ${dump:h} ]] || mkdir -p ${dump:h}

        # When the audit last ran, kept apart from the dump on purpose: compinit
        # rewrites the dump only when the number of completion functions has
        # changed, so the dump's own mtime stands still on a machine that
        # installs nothing -- and using it as the clock would mean auditing at
        # every start from the second day on, which is the bug this file is
        # trying to fix.
        local stamp=$dump.audited

        # Nmh-24: the stamp exists and is less than 24 hours old. The glob has
        # to happen in an array assignment -- [[ ]] never globs, so the
        # `[[ -n $stamp(#qNmh-24) ]]` spelling that circulates is always true,
        # and silently means "never audit again".
        local -a fresh=( $stamp(Nmh-24) )

        if (( $#fresh )) && [[ -s $dump ]]; then
            # -C: trust the dump. No compaudit, and no check for completion
            # functions that appeared since it was written.
            compinit -C -d $dump
        else
            compinit -i -d $dump
            : >| $stamp

            # zsh reads $dump.zwc in place of $dump whenever it is the newer of
            # the two, and parsing the dump is most of what -C leaves behind.
            [[ -f $dump.zwc && ! $dump -nt $dump.zwc ]] ||
                zcompile -R -- $dump 2>/dev/null
        fi
    }
fi

# mise's completions are generated on demand -- `mise completion zsh` shells out
# to the `usage` CLI, which is a process or two at every single shell start.
# This stub stands in until the first Tab on a mise command line: it then loads
# the real completion, which rebinds `mise` to its own `_mise`, and hands that
# first Tab over. Every later one goes straight there.
#
# The generated script needs the `usage` CLI on the PATH (`mise use -g usage`);
# without it, it says so rather than completing.
if (( $+commands[mise] && $+functions[compdef] )); then
    _mise_lazy() {
        unfunction _mise_lazy
        eval "$(mise completion zsh)"
        _mise "$@"
    }

    compdef _mise_lazy mise
fi

# rig appends this line to every startup file it knows about,
# and only ever checks that the line is there:
# ~/.profile sources rigenv once, for every shell, so this copy stays off.
if false; then
. "$HOME/.local/bin/rigenv"
fi

# ---------------------------------------------------------------------------
# Eternal history
#
# One file per day under a directory, so no single file grows without bound
# and everything older stays on disk and greppable.
#
# What bash needed PROMPT_COMMAND for, zsh does natively: SHARE_HISTORY
# appends each command as it is entered and imports what other shells have
# appended, so concurrent sessions stay in sync with no hook.
# ---------------------------------------------------------------------------
HISTSIZE=10000000
SAVEHIST=$HISTSIZE

setopt EXTENDED_HISTORY     # `: <epoch>:<elapsed>;<cmd>` -- bash's HISTTIMEFORMAT
setopt SHARE_HISTORY        # append as you go; pick up other shells' entries
setopt HIST_IGNORE_SPACE    # a leading space keeps a command out
setopt HIST_IGNORE_DUPS     # collapse an immediate repeat
setopt HIST_REDUCE_BLANKS

# Deliberate, and the reason is the whole point of keeping history forever:
# HIST_IGNORE_ALL_DUPS keeps only the most recent instance of a command, which
# destroys the frequency information. "Which commands do I run enough that they
# should be scripts in ~/bin" is a question only the counts can answer.
unsetopt HIST_IGNORE_ALL_DUPS

__zsh_history_dir="$HOME/.zsh_history.d"
[[ -d $__zsh_history_dir ]] || mkdir -p "$__zsh_history_dir"

# One-time migration of a single-file history, matching what the bash side does
# with ~/.bash_eternal_history.
if [[ -f $HOME/.zsh_history && ! -e $__zsh_history_dir/legacy.log ]]; then
  mv "$HOME/.zsh_history" "$__zsh_history_dir/legacy.log"
fi

# ${(%):-%D{...}} is strftime via prompt expansion -- the same string $(date)
# would give, without the fork. This runs at every prompt below, so a fork here
# would be a fork per command.
HISTFILE="$__zsh_history_dir/${(%):-%D{%Y-%m-%d}}.log"

# Pull prior days into the in-memory list so Ctrl-R reaches them. Today's file
# is skipped: zsh loads $HISTFILE itself, and reading it twice duplicates every
# entry. (N) is null-glob, so an empty directory is not an error.
() {
  local f
  for f in "$__zsh_history_dir"/legacy.log(N) "$__zsh_history_dir"/[0-9]*.log(N); do
    [[ $f == $HISTFILE ]] && continue
    fc -R "$f"
  done
}

# Roll over at midnight without needing a new shell. `fc -A` appends only what
# is new -- never `fc -W`, which would write the entire preloaded history into
# today's file and duplicate every prior day.
autoload -Uz add-zsh-hook
__zsh_history_rotate() {
  local today="$__zsh_history_dir/${(%):-%D{%Y-%m-%d}}.log"
  [[ $HISTFILE == $today ]] && return
  fc -A
  HISTFILE=$today
}
add-zsh-hook precmd __zsh_history_rotate

# ---------------------------------------------------------------------------
# The bash bridge
#
# bashcompinit first: ~/.bash_aliases (via ~/.bash_aliases_os on macOS) calls
# `complete`, which is not a zsh builtin without it.
#
# ~/.bash_secrets is sourced unguarded by bash_aliases itself, so it has to
# exist: `touch ~/.bash_secrets` if it does not.
# ---------------------------------------------------------------------------
autoload -Uz bashcompinit && bashcompinit
[[ -r $HOME/.bash_aliases ]] && source "$HOME/.bash_aliases"

# ---------------------------------------------------------------------------
# Editor and aliases
# ---------------------------------------------------------------------------
if [[ $TERM_PROGRAM == vscode ]]; then
  case $__CFBundleIdentifier in
    com.microsoft.VSCode) export EDITOR="code --wait" ;;
    co.posit.positron)    export EDITOR="positron --wait" ;;
  esac
fi

compdef g=git

# ---------------------------------------------------------------------------
# Semantic prompt marks (OSC 133)
#
# Escape sequences that tell the terminal where a prompt begins and ends,
# where the command it accepted started running,
# and where that command ended with which exit status.
# A terminal that reads them can jump from prompt to prompt,
# select or copy the output of a single command,
# and tell a command that failed from one that did not;
# tmux 3.4 and later reads the first two as well,
# and its `previous-prompt` and `next-prompt` navigate by nothing else.
# A terminal that does not read them ignores them --
# they take up no columns, and none of this is tied to one terminal.
#
# Nothing here starts a process:
# `print` is a builtin, the strings are constants,
# and the prompt mark is expanded by zsh's own prompt machinery.
#
# All four marks are sent: A where a prompt starts, B where it ends and what
# was typed begins, C where the command's output starts, D where the command
# ended and with what status.
# tmux 3.4 records A and C and drops the other two on the floor
# (`input_osc_133` in its source knows those two cases and no more),
# so B and D are for the terminal alone --
# B is how iTerm2 tells the prompt from the command that was typed after it,
# and D is what colours a failed command anywhere.
#
# The section is this late in the file on purpose:
# A and B go into $PS1,
# so whatever sets a prompt -- ~/.bash_aliases, by way of the bridge above --
# has to have done so already.
# Anything that replaces $PS1 *after* this point takes the marks with it;
# nothing here does, and a prompt framework that did would have to add its own.
# ---------------------------------------------------------------------------

# Ghostty injects a shell integration of its own that sends these very
# sequences, and two of everything is worse than one of it:
# two prompt starts and two command ends per command line.
#
# The condition asks whether that integration is loaded *in this shell*,
# rather than whether this is a Ghostty window.
# Ghostty exports $TERM_PROGRAM to every process it starts, but injects the
# integration exactly once, through $ZDOTDIR, in the first shell:
# a `zsh` started inside that one, or by tmux, or by vim's :terminal,
# has the variable and none of the marks,
# and would have been left silently unmarked by a test on $TERM_PROGRAM.
# What the injection does leave in this shell is a precmd hook of its own,
# added in Ghostty's ~/.zshenv before this file is read.
#
# There is no Ghostty-side switch to prefer instead:
# `shell-integration-features` takes cursor, sudo, title, ssh-env,
# ssh-terminfo and path -- there is no prompt-mark among them,
# and `shell-integration = none` would turn off the other four features
# to be rid of the marking.
#
# Leaning on the name of another project's function is the price.
# It is the safe direction to be wrong in:
# if Ghostty renames it, both integrations mark, which is untidy --
# tmux flags a line the same whether it is told once or twice --
# where a missed guard would mean no marks at all.
if [[ -z ${precmd_functions[(r)_ghostty_deferred_init]} ]]; then
  autoload -Uz add-zsh-hook

  # C and D are events -- output started, a command ended -- and a hook is
  # where an event belongs.
  #
  # The flag is what keeps D honest. precmd runs before every prompt, not
  # after every command, so sending D unconditionally would report a
  # command-end before the first prompt of a session, and another for every
  # bare Enter -- each one carrying the status of the last real command, which
  # is how one failed command comes to paint three prompts red.
  # Ghostty's own integration keeps the same state for the same reason.
  #
  # $? is the status of the command line even though another precmd hook (the
  # history rotation above) ran first: zsh restores it around each hook
  # function, so the order of the hooks in this file does not matter.
  typeset -g _osc133_command_ran=0

  _osc133_preexec() {
    _osc133_command_ran=1
    print -n "\e]133;C\a"
  }

  _osc133_precmd() {
    local ret=$?
    (( _osc133_command_ran )) || return 0
    _osc133_command_ran=0
    print -n "\e]133;D;$ret\a"
  }

  add-zsh-hook precmd _osc133_precmd
  add-zsh-hook preexec _osc133_preexec

  # A and B are not events but places -- *this line* is where a prompt starts,
  # *this column* is where what I typed begins -- and that is why they go into
  # the prompt rather than into precmd with the other two.
  # The line editor redraws a prompt from scratch every time: carriage return,
  # `\e[J` to erase from the cursor to the end of the screen, then the prompt.
  # tmux forgets what it knew about the lines that erase clears, and precmd
  # runs before all of it, so a mark sent from there is wiped a moment after
  # it arrives: only the first prompt of a session stays marked, and
  # `previous-prompt` jumps from where you are to the top of the session and
  # nowhere in between.
  # Sent from inside the prompt they arrive after the erase, and are sent again
  # at every redraw, which costs nothing -- flagging a line twice is flagging
  # it once.
  #
  # %{...%} is how zsh is told that what it encloses occupies no columns;
  # without it the prompt believes it is that many characters wider than it is.
  # It is a prompt escape, so a prompt that has escapes switched off
  # (`unsetopt prompt_percent`) would print the braces instead: then no marks.
  #
  # The second test is what keeps a `source ~/.zshrc` from adding a second
  # copy of them.
  if [[ -o prompt_percent && $PS1 != *$'\e]133;A\a'* ]]; then
    # A prompt ending in a lone % would take the { of the mark that follows it
    # for the start of a %{ escape, swallow the mark and print a stray brace.
    # Doubling it makes it the literal percent it was meant to be.
    # (Ghostty's integration carries the same two lines, for the same reason.)
    [[ $PS1 == *[^%]% || $PS1 == % ]] && PS1=$PS1%

    PS1=$'%{\e]133;A\a%}'$PS1$'%{\e]133;B\a%}'
  fi
fi

# Last line on purpose: the mark records when this file was *done*, and the gap
# between it and the first prompt is everything the terminal does after the
# configuration has finished.
# >>> zsh startup profiling >>>
zsh_startup_mark zshrc
# <<< zsh startup profiling <<<
