# ~/.zshrc: read by interactive zsh shells.
#
# The PATH is set up in ~/.profile, which ~/.zprofile hands to zsh at login;
# this file is only for what an interactive shell needs.

# The completion system, unless something has already started it.
#
# -i skips insecure directories rather than stopping to ask about them: with no
# terminal to ask on -- a script, a container, `zsh -c` -- plain compinit aborts
# and leaves no compdef behind at all.
#
# The audit is what costs. `-i` does not skip it, it only stops it from asking:
# compaudit still stats every directory in $fpath, which on macOS is Homebrew's
# site-functions and a good part of /usr/share, and it was half of what the
# whole rc chain spent (`zsh-startup-bench --zprof`). It is worth doing, and it
# is not worth doing at every single shell start -- so the audit runs when the
# dump is more than a day old, and every other shell trusts the dump.
#
# `zsh-compinit-refresh` forces the refresh, for the day a newly installed tool
# should complete right now rather than tomorrow.
if ! (( $+functions[compdef] )); then
    autoload -Uz compinit

    () {
        local dump=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION
        [[ -d ${dump:h} ]] || mkdir -p ${dump:h}

        # When the audit last ran, kept apart from the dump on purpose: compinit
        # rewrites the dump only when the number of completion functions has
        # changed, so the dump's own mtime stands still on a machine that
        # installs nothing -- and using it as the clock would mean auditing at
        # every start from the second day on, which is the bug this file is
        # trying to fix.
        local stamp=$dump.audited

        # Nmh-24: the stamp exists and is less than 24 hours old. The glob has
        # to happen in an array assignment -- [[ ]] never globs, so the
        # `[[ -n $stamp(#qNmh-24) ]]` spelling that circulates is always true,
        # and silently means "never audit again".
        local -a fresh=( $stamp(Nmh-24) )

        if (( $#fresh )) && [[ -s $dump ]]; then
            # -C: trust the dump. No compaudit, and no check for completion
            # functions that appeared since it was written.
            compinit -C -d $dump
        else
            compinit -i -d $dump
            : >| $stamp

            # zsh reads $dump.zwc in place of $dump whenever it is the newer of
            # the two, and parsing the dump is most of what -C leaves behind.
            [[ -f $dump.zwc && ! $dump -nt $dump.zwc ]] ||
                zcompile -R -- $dump 2>/dev/null
        fi
    }
fi

# mise's completions are generated on demand -- `mise completion zsh` shells out
# to the `usage` CLI, which is a process or two at every single shell start.
# This stub stands in until the first Tab on a mise command line: it then loads
# the real completion, which rebinds `mise` to its own `_mise`, and hands that
# first Tab over. Every later one goes straight there.
#
# The generated script needs the `usage` CLI on the PATH (`mise use -g usage`);
# without it, it says so rather than completing.
if (( $+commands[mise] && $+functions[compdef] )); then
    _mise_lazy() {
        unfunction _mise_lazy
        eval "$(mise completion zsh)"
        _mise "$@"
    }

    compdef _mise_lazy mise
fi

# rig appends this line to every startup file it knows about,
# and only ever checks that the line is there:
# ~/.profile sources rigenv once, for every shell, so this copy stays off.
if false; then
. "$HOME/.local/bin/rigenv"
fi

# ---------------------------------------------------------------------------
# Eternal history
#
# One file per day under a directory, so no single file grows without bound
# and everything older stays on disk and greppable.
#
# Why the counts are kept rather than the commands deduplicated, why the day's
# commands are on disk before any hook runs, and what `zsh-history-repair` is
# for: handbook/config/history/README.md in the scriptlets repository.
# ---------------------------------------------------------------------------
HISTSIZE=10000000
SAVEHIST=$HISTSIZE

setopt EXTENDED_HISTORY     # `: <epoch>:<elapsed>;<cmd>` -- bash's HISTTIMEFORMAT
setopt SHARE_HISTORY        # append as you go; pick up other shells' entries
setopt HIST_IGNORE_SPACE    # a leading space keeps a command out
setopt HIST_IGNORE_DUPS     # collapse an immediate repeat
setopt HIST_REDUCE_BLANKS

# Deliberate: this is what keeps the frequency counts.
unsetopt HIST_IGNORE_ALL_DUPS

__zsh_history_dir="$HOME/.zsh_history.d"
[[ -d $__zsh_history_dir ]] || mkdir -p "$__zsh_history_dir"

# One-time migration of a single-file history, matching what the bash side does
# with ~/.bash_eternal_history.
if [[ -f $HOME/.zsh_history && ! -e $__zsh_history_dir/legacy.log ]]; then
  mv "$HOME/.zsh_history" "$__zsh_history_dir/legacy.log"
fi

# ${(%):-"%D{...}"} is strftime via prompt expansion -- the same string $(date)
# would give, without the fork. This runs at every prompt below, so a fork here
# would be a fork per command.
#
# The format is quoted, and has to be: unquoted, the expansion ends at the first
# } it meets, which is %D's own, and the second lands in the file name.
HISTFILE="$__zsh_history_dir/${(%):-"%D{%Y-%m-%d}"}.log"

# Pull prior days into the in-memory list so Ctrl-R reaches them. Today's file
# is skipped: zsh loads $HISTFILE itself, and reading it twice duplicates every
# entry. (N) is null-glob, so an empty directory is not an error.
() {
  local f
  for f in "$__zsh_history_dir"/legacy.log(N) "$__zsh_history_dir"/[0-9]*.log(N); do
    [[ $f == $HISTFILE ]] && continue
    fc -R "$f"
  done
}

# Roll over at midnight without needing a new shell: point HISTFILE at today and
# nothing else.
#
# Nothing is written here, and nothing may be. SHARE_HISTORY has already appended
# the day's commands to the day's file, and any write from this hook writes the
# preloaded history with them -- `fc -A` does not exclude what it did not write.
autoload -Uz add-zsh-hook
__zsh_history_rotate() {
  local today="$__zsh_history_dir/${(%):-"%D{%Y-%m-%d}"}.log"
  [[ $HISTFILE == $today ]] && return
  HISTFILE=$today
}
add-zsh-hook precmd __zsh_history_rotate

# ---------------------------------------------------------------------------
# The bash bridge
#
# bashcompinit first: ~/.bash_aliases (via ~/.bash_aliases_os on macOS) calls
# `complete`, which is not a zsh builtin without it.
# ---------------------------------------------------------------------------
autoload -Uz bashcompinit && bashcompinit
[[ -r $HOME/.bash_aliases ]] && source "$HOME/.bash_aliases"

# ---------------------------------------------------------------------------
# mise: the tools a directory asks for, on the PATH -- activated from a
# generated script kept on disk rather than produced by a process at every
# shell. The bash half of this is in ~/.bashrc and works the same way.
#
# After the bash bridge above on purpose: `mise activate` records the PATH it
# found as $__MISE_ORIG_PATH, which is what a later `mise deactivate` puts
# back, and ~/.bash_aliases_os adds to the PATH on Linux.
#
# What makes the file stale, why it is named for the binary it came from, and
# how to force a rewrite by hand:
# handbook/config/mise/README.md in the scriptlets repository.
# ---------------------------------------------------------------------------
if (( $+commands[mise] )); then
    # Named for the binary that generated it, because `mise activate` writes
    # that path into the script: a second mise at another path -- Homebrew's
    # beside the one mise.run installed -- gets a file of its own rather than
    # the first one's, whose hardcoded path it would otherwise keep calling.
    __mise_init=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-activate-${${commands[mise]#/}//\//-}.zsh

    # Whether the file is newer than mise, rather than whether mise is newer
    # than the file, so that a tie counts as an upgrade -- the spelling the
    # bash half needs, where whole seconds are all the comparison has, and the
    # one both should be read with.
    if [[ ! -s $__mise_init || ! $__mise_init -nt $commands[mise] ]]; then
        # An anonymous function, so the names below are gone before the
        # generated script is sourced -- which happens at the outer level, the
        # way `eval "$(mise activate zsh)"` would.
        () {
            local new=$1.$$
            # Quiet, and giving up rather than writing into a directory
            # that is not there: a cache that cannot be made is meant to cost
            # a shell its mise, and a redirection zsh cannot honour is a
            # complaint before every prompt.
            [[ -d ${1:h} ]] || mkdir -p ${1:h} 2>/dev/null || return

            # -s and zcompile are what "good enough to publish" means: a write
            # cut short leaves a script that does not parse, and the file being
            # replaced is one every interactive shell sources.
            if ! {
                mise activate zsh >| $new 2>/dev/null &&
                    [[ -s $new ]] &&
                    zcompile -R -- $new 2>/dev/null &&
                    mv -f $new.zwc $1.zwc &&
                    mv -f $new $1
            }; then
                rm -f $new $new.zwc
            fi
        } $__mise_init
    fi

    # Guarded on the same test rather than on the file's existence, so a
    # machine where it could never be written -- a read-only cache directory,
    # a mise that cannot run -- gets a shell without mise rather than an error
    # before every prompt.
    [[ -s $__mise_init ]] && source $__mise_init
    unset __mise_init
fi

# ---------------------------------------------------------------------------
# Editor and aliases
# ---------------------------------------------------------------------------
# The default is ~/.profile's, for every shell
# (handbook/config/editor/README.md); a terminal that is an editor window
# takes it over, so that a commit written there opens where it was started.
if [[ $TERM_PROGRAM == vscode ]]; then
  case $__CFBundleIdentifier in
    com.microsoft.VSCode) export EDITOR="code --wait" ;;
    co.posit.positron)    export EDITOR="positron --wait" ;;
  esac

  # $VISUAL follows $EDITOR rather than standing still: git and zsh's
  # edit-command-line both read it first, so the value from ~/.profile would
  # shadow the line above and open the editor this terminal is not.
  export VISUAL=$EDITOR
fi

compdef g=git

# ---------------------------------------------------------------------------
# Semantic prompt marks (OSC 133): where a prompt begins and ends, where a
# command started producing output, where it ended and with what status.
#
# Why A and B go in the prompt rather than in a hook, why D waits for a
# command to have run, and what the condition below is really asking:
# handbook/config/prompt-marks/README.md in the scriptlets repository.
# ---------------------------------------------------------------------------
if [[ -z ${precmd_functions[(r)_ghostty_deferred_init]} ]]; then
  autoload -Uz add-zsh-hook

  typeset -g _osc133_command_ran=0

  _osc133_preexec() {
    _osc133_command_ran=1
    print -n "\e]133;C\a"
  }

  _osc133_precmd() {
    local ret=$?
    (( _osc133_command_ran )) || return 0
    _osc133_command_ran=0
    print -n "\e]133;D;$ret\a"
  }

  add-zsh-hook precmd _osc133_precmd
  add-zsh-hook preexec _osc133_preexec

  if [[ -o prompt_percent && $PS1 != *$'\e]133;A\a'* ]]; then
    # A prompt ending in a lone % would take the { after it for a %{ escape.
    [[ $PS1 == *[^%]% || $PS1 == % ]] && PS1=$PS1%

    PS1=$'%{\e]133;A\a%}'$PS1$'%{\e]133;B\a%}'
  fi
fi

# ---------------------------------------------------------------------------
# The working directory (OSC 7): what a terminal opens a new tab, split or
# window in, and what it resolves a clicked file name against.
#
# Why the path is encoded a byte at a time, why it is sent from two hooks
# rather than one, and what tmux does with it:
# handbook/config/current-directory/README.md in the scriptlets repository.
# ---------------------------------------------------------------------------
if [[ -z ${precmd_functions[(r)_ghostty_deferred_init]} ]]; then
  autoload -Uz add-zsh-hook

  _osc7_report_cwd() {
    # LC_ALL=C makes the pattern match one byte at a time, so a path outside
    # ASCII becomes the UTF-8 bytes a file URL is made of rather than code
    # points. Nothing here forks: $(( )) is arithmetic, not a command.
    setopt localoptions extended_glob
    local LC_ALL=C
    local -a match mbegin mend
    local encoded=${PWD//(#m)[^A-Za-z0-9_.!~*()\'\/-]/%${(l:2::0:)$(([##16]#MATCH))}}
    print -n "\e]7;file://${HOST}${encoded}\a"
  }

  add-zsh-hook chpwd _osc7_report_cwd
  add-zsh-hook precmd _osc7_report_cwd
fi

# ---------------------------------------------------------------------------
# ^X^E opens the command line being typed in the editor, and takes back
# whatever the editor leaves behind
# (handbook/config/editor/README.md in the scriptlets repository).
#
# `autoload` registers the name and reads nothing: the function is compiled on
# the first press of the key and never in a shell that does not press it,
# which is what keeps a widget off the startup budget.
# ---------------------------------------------------------------------------
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Last line on purpose: the mark records when this file was *done*, and the gap
# between it and the first prompt is everything the terminal does after the
# configuration has finished.
# >>> zsh startup profiling >>>
zsh_startup_mark zshrc
# <<< zsh startup profiling <<<
