# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=-1
HISTFILESIZE=-1

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi

  source <(kubectl completion bash)
  complete -F __start_kubectl k
fi

# added by travis gem
if [ -f ~/.env ]; then
    . ~/.env
fi


# Eternal bash history.
# ---------------------
# History is split into per-day files under ~/.bash_history.d/ so individual
# files stay bounded.  HISTTIMEFORMAT records a timestamp for each command;
# 'history -a' then 'history -n' in PROMPT_COMMAND keep concurrent shells in
# sync after every command, including empty ones (just press Enter).
#
# Migration: a pre-existing ~/.bash_eternal_history (the previous single-file
# layout) is moved to ~/.bash_history.d/legacy.log the first time this runs.
# Older entries remain searchable on disk; grep the directory to find them.
export HISTTIMEFORMAT="[%F %T] "

__bash_history_dir="$HOME/.bash_history.d"
mkdir -p "$__bash_history_dir"

if [ -f "$HOME/.bash_eternal_history" ] && [ ! -e "$__bash_history_dir/legacy.log" ]; then
    mv "$HOME/.bash_eternal_history" "$__bash_history_dir/legacy.log" 2>/dev/null
fi

# Today's file; bash auto-loads HISTFILE at shell start.
HISTFILE="$__bash_history_dir/$(date +%Y-%m-%d).log"

# Pull prior days (and the migrated legacy file) into the in-memory history
# list so Ctrl-R reaches them.  Today's file is skipped here because bash
# auto-loads $HISTFILE after .bashrc; loading it twice would duplicate entries.
__bash_history_preload() {
    local f
    [ -f "$__bash_history_dir/legacy.log" ] && history -r "$__bash_history_dir/legacy.log"
    for f in "$__bash_history_dir"/[0-9]*.log; do
        [ -e "$f" ] || break
        [ "$f" = "$HISTFILE" ] && continue
        history -r "$f"
    done
}
__bash_history_preload
unset -f __bash_history_preload

__bash_history_sync() {
    local today="$__bash_history_dir/$(date +%Y-%m-%d).log"
    if [ "$HISTFILE" != "$today" ]; then
        history -a
        HISTFILE="$today"
    fi
    history -a   # flush this session's new commands to today's file
    history -n   # pull commands appended by other sessions
}

PROMPT_COMMAND="__bash_history_sync${PROMPT_COMMAND:+; $PROMPT_COMMAND}"


# bash-git-prompt, must come after history

function prompt_callback {
    echo -n "\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]"
}

# Set config variables first
# GIT_PROMPT_ONLY_IN_REPO=1

GIT_PROMPT_FETCH_REMOTE_STATUS=0   # uncomment to avoid fetching remote status
# GIT_PROMPT_IGNORE_SUBMODULES=1 # uncomment to avoid searching for changed files in submodules

# GIT_PROMPT_SHOW_UPSTREAM=1 # uncomment to show upstream tracking branch
# GIT_PROMPT_SHOW_UNTRACKED_FILES=normal # can be no, normal or all; determines counting of untracked files

GIT_PROMPT_SHOW_CHANGED_FILES_COUNT=0 # uncomment to avoid printing the number of changed files

# GIT_PROMPT_STATUS_COMMAND=gitstatus_pre-1.7.10.sh # uncomment to support Git older than 1.7.10

# GIT_PROMPT_START=...    # uncomment for custom prompt start sequence
#GIT_PROMPT_START="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]"
#GIT_PROMPT_START="\[\e]0;\a\]"
# GIT_PROMPT_END=...      # uncomment for custom prompt end sequence

# as last entry source the gitprompt script
# GIT_PROMPT_THEME=Custom # use custom theme specified in file GIT_PROMPT_THEME_FILE (default ~/.git-prompt-colors.sh)
# GIT_PROMPT_THEME_FILE=~/.git-prompt-colors.sh
GIT_PROMPT_THEME=Solarized_Ubuntu # use theme optimized for solarized color scheme
source ~/git/bash-git-prompt/gitprompt.sh


export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

alias gco="git co"

. ~/git/complete-alias/complete_alias

if [ -d /opt/homebrew ]; then
  export PATH=/opt/homebrew/bin:$PATH
fi

# ---------------------------------------------------------------------------
# mise: the tools a directory asks for, on the PATH -- activated from a
# generated script kept on disk rather than produced by a process at every
# shell. The zsh half of this is in ~/.zshrc and works the same way.
#
# After everything that adds to the PATH, the block above included, on
# purpose: `mise activate` records the PATH it found as $__MISE_ORIG_PATH,
# which is what a later `mise deactivate` puts back, so it should see the
# finished one.
#
# What makes the file stale, why it is named for the binary it came from, and
# how to force a rewrite by hand:
# handbook/config/mise/README.md in the scriptlets repository.
# ---------------------------------------------------------------------------
if command -v mise >/dev/null 2>&1; then
    # `type -P` searches the PATH even once mise's own shell function exists,
    # and forks nothing to do it. The path is part of the file name because
    # `mise activate` writes it into the script: a second mise elsewhere gets
    # a file of its own rather than one that calls the first one forever.
    __mise_bin=$(type -P mise)
    __mise_key=${__mise_bin#/}
    __mise_init="${XDG_CACHE_HOME:-$HOME/.cache}/bash/mise-activate-${__mise_key//\//-}.bash"

    # The question is whether the file is newer than mise, rather than whether
    # mise is newer than the file, so that a tie counts as an upgrade. macOS's
    # own bash compares whole seconds: a mise replaced in the same second the
    # file was written would otherwise never be newer than it, and the file
    # would stand until someone deleted it by hand. A tie the other way costs
    # one rewrite, and only until the clock moves on.
    if [[ ! -s $__mise_init || ! $__mise_init -nt $__mise_bin ]]; then
        # Quiet, and the directory is tested rather than assumed: a cache
        # that cannot be made is meant to cost the shell its mise, and a
        # redirection into a directory that is not there is a complaint
        # before every prompt.
        mkdir -p "${__mise_init%/*}" 2>/dev/null
        __mise_new="$__mise_init.$$"

        # `bash -n` is a fork, and it happens only on the rewrite -- which is
        # once per mise, not once per shell. A write cut short would otherwise
        # be a syntax error before every prompt from here on.
        if [ -d "${__mise_init%/*}" ] &&
            mise activate bash >|"$__mise_new" 2>/dev/null &&
            [ -s "$__mise_new" ] &&
            bash -n "$__mise_new" 2>/dev/null; then
            mv -f "$__mise_new" "$__mise_init"
        else
            # Quiet for the same reason the mkdir is: where the cache
            # directory could not be made, BSD `rm -f` still reports the path
            # below it as not a directory, once before every prompt.
            rm -f "$__mise_new" 2>/dev/null
        fi
    fi

    # On the same test rather than on the file's existence: where it could
    # never be written, this is a shell without mise rather than an error
    # before every prompt.
    [ -s "$__mise_init" ] && . "$__mise_init"
    unset __mise_bin __mise_key __mise_init __mise_new
fi

# rig appends this line to every startup file it knows about,
# and only ever checks that the line is there:
# ~/.profile sources rigenv once, for every shell, so this copy stays off.
if false; then
. "$HOME/.local/bin/rigenv"
fi

# ---------------------------------------------------------------------------
# Semantic prompt marks (OSC 133): where a prompt begins, where a command
# started producing output, where it ended and with what status.
#
# Why bash prints them instead of keeping them in $PS1 as zsh does, what PS0
# has to do with it, and what a bash older than 4.4 gets:
# handbook/config/prompt-marks/README.md in the scriptlets repository.
#
# Last in the file, so that this runs first at every prompt: $? belongs to the
# command line only until the next thing in $PROMPT_COMMAND has run.
# ---------------------------------------------------------------------------
case " ${BASH_SOURCE[*]} " in
*ghostty*) ;;
*)
    # PS0 is printed once a command line has been read and before it runs,
    # which is what C means. ${x:=y} assigns as it expands, so the one
    # expansion also leaves behind the fact that a command ran.
    if shopt -q promptvars; then
        __osc133_output_mark=$'\033]133;C\007'
        PS0='${__osc133_ran:=$__osc133_output_mark}'
    fi

    __osc133_precmd() {
        local ret=$?

        if [ -n "${__osc133_ran:-}" ]; then
            __osc133_ran=
            printf '\033]133;D;%s\007' "$ret"
        fi

        printf '\033]133;A\007'
    }

    PROMPT_COMMAND="__osc133_precmd${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
    ;;
esac
